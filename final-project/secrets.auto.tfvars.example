# --- Terraform secrets template ---
# Copy this file to "secrets.auto.tfvars" and fill in real values.
# secrets.auto.tfvars is git-ignored and auto-loaded by Terraform on apply.
#
#   cp secrets.auto.tfvars.example secrets.auto.tfvars
#   # then edit secrets.auto.tfvars
#
# Alternatively export as environment variables instead of using this file:
#   export TF_VAR_github_username='...'
#   export TF_VAR_github_pat='...'
#   export TF_VAR_jenkins_admin_password='...'
#   export TF_VAR_db_password='...'
#   export TF_VAR_grafana_admin_password='...'
#   export TF_VAR_django_secret_key='...'

github_username        = "CHANGE_ME_github_username"
github_pat             = "CHANGE_ME_ghp_token"
jenkins_admin_password = "CHANGE_ME_jenkins_admin"
db_password            = "CHANGE_ME_db_password"
grafana_admin_password = "CHANGE_ME_grafana_admin"
django_secret_key      = "CHANGE_ME_django_secret_key"
